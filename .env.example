# Copy this file to `.env` and fill in real values.
# Never commit `.env` — it's gitignored.

# --- Gemini (text drafting + image generation) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Gmail SMTP (sending newsletter) ---
# Required only if you actually want to send email (omit --no-send).
# 1. Turn on 2-Step Verification on your Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password below (spaces are stripped).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=

# --- Newsletter addresses ---
# FROM must equal SMTP_USER for Gmail to accept the message.
NEWSLETTER_FROM_EMAIL=your.address@gmail.com
NEWSLETTER_TO_EMAIL=your.address@gmail.com

# --- Optional: better web search ---
# Sign up for free at https://tavily.com/ to upgrade research quality.
# TAVILY_API_KEY=
