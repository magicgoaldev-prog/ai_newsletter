<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ newsletter.title }}</title>
  <style>
{{ css }}
  </style>
</head>
<body>
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="wrapper" width="100%">
    <tr>
      <td align="center">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="container" width="640">
          <tr>
            <td class="masthead">
              <p class="eyebrow">{{ newsletter.topic }}</p>
              <h1>{{ newsletter.title }}</h1>
              <p class="subtitle">{{ newsletter.subtitle }}</p>
            </td>
          </tr>

          {% if hero_image %}
          <tr>
            <td>
              <img src="{{ hero_image }}" alt="Hero illustration" class="hero-image">
            </td>
          </tr>
          {% endif %}

          <tr>
            <td class="hero-blurb">{{ newsletter.hero_blurb }}</td>
          </tr>

          {% for section in newsletter.sections %}
          <tr>
            <td class="section">
              <h2>{{ section.heading }}</h2>
              {% if section_images.get(loop.index0) %}
                <img src="{{ section_images[loop.index0] }}" alt="{{ section.heading }}" class="section-image">
              {% endif %}
              <div class="body">
                {{ section.body_html | safe }}
              </div>
              {% if section.key_takeaway %}
                <div class="takeaway"><strong>Key takeaway:</strong> {{ section.key_takeaway }}</div>
              {% endif %}
            </td>
          </tr>
          {% endfor %}

          <tr>
            <td>
              <div class="cta">{{ newsletter.cta }}</div>
            </td>
          </tr>

          <tr>
            <td class="sources">
              <h3>Sources</h3>
              <ol>
                {% for url in newsletter.sources %}
                  <li><a href="{{ url }}">{{ url }}</a></li>
                {% endfor %}
              </ol>
            </td>
          </tr>

          <tr>
            <td class="footer">
              Generated by the WAT newsletter pipeline.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
